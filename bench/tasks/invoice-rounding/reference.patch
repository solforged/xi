 def parse(lines):
-    for line in lines:
-        invoice, currency, amount = line.rstrip('\n').split(',')
-        yield Entry(invoice, currency, Decimal(amount))
+    reader = csv.reader(lines, strict=True)
+    while True:
+        try:
+            row = next(reader)
+        except StopIteration:
+            return
+        except csv.Error as error:
+            raise ValueError(f'line {reader.line_num}: invalid CSV') from error
+        if not row or (len(row)==1 and not row[0].strip()):
+            continue
+        try:
+            invoice, currency, amount = (value.strip() for value in row)
+            value = Decimal(amount)
+            if not invoice or not re.fullmatch('[A-Z]{3}',currency) or not value.is_finite():
+                raise ValueError('invalid field')
+        except (ValueError, InvalidOperation) as error:
+            raise ValueError(f'line {reader.line_num}: invalid row') from error
+        yield Entry(invoice,currency,value)
