-from decimal import Decimal
+from decimal import Decimal, localcontext, ROUND_HALF_EVEN, ROUND_HALF_UP
 
 def totals(entries, options):
+    # Integer coefficients keep grouping exact, independently of Decimal context.
+    scale = 20
+    groups = {}
+    for index, entry in enumerate(entries):
+        sign, digits, exponent = entry.amount.as_tuple()
+        coefficient = int(''.join(map(str,digits))) * (-1 if sign else 1)
+        coefficient *= 10 ** (scale + exponent)
+        key = (entry.invoice if options.scope == 'invoice' else index, entry.currency)
+        groups[key] = groups.get(key,0) + coefficient
+    divisor = 10 ** (scale-options.precision)
     result = {}
-    quantum = Decimal(10) ** -options.precision
-    for entry in entries:
-        result[entry.currency] = result.get(entry.currency, Decimal(0)) + entry.amount.quantize(quantum)
-    return result
+    for (_,currency), amount in groups.items():
+        whole, rem = divmod(abs(amount),divisor)
+        if rem*2 > divisor or (rem*2 == divisor and (options.rounding == 'away' or whole % 2)):
+            whole += 1
+        result[currency] = result.get(currency,0) + (-whole if amount < 0 else whole)
+    return {currency: Decimal((int(value < 0), tuple(map(int,str(abs(value)))), -options.precision)) for currency,value in result.items()}
