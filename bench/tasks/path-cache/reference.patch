+from urllib.parse import urlsplit, urlunsplit
+
+
+def cache_key(method, url):
+    """Build a method/URL key; fragments never reach the server."""
+    parts = urlsplit(url)
+    userinfo, separator, hostport = parts.netloc.rpartition("@")
+    netloc = userinfo + separator + hostport.lower()
+    return method.upper(), urlunsplit((parts.scheme.lower(), netloc, parts.path, parts.query, ""))
